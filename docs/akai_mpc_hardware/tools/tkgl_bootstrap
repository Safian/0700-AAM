#!/bin/sh
# tkgl_bootstrap: Akai MPC Key 61 bootstrap script for Behringer Kick
#
# Called by /usr/bin/az01-launch-MPC (TheKikGen MPC-LiveXplore bootstrap hook).
# Behavior per owner decision (2026-11-04):
#  1. Automatically installs / updates Kick onto the internal flash (/data).
#  2. Compares VERSION content: updates/downgrades on difference; skips writes on match.
#  3. Atomic replacement (/data/Kick.new -> SHA256 check -> backup -> mv -> Kick.version last).
#  4. Always executes Kick from the internal flash (/data/Kick), never USB directly.
#  5. Falls back cleanly to stock MPC (exit 0) if no runnable Kick is available.
#  6. User projects (/data/projects) and preferences (/data/prefs) are never overwritten.
#  7. Supports USB UNINSTALL trigger (place UNINSTALL on USB drive -> removes Kick -> stock MPC).
#  8. Never installs an unverified binary: a missing sha256 tool or a package VERSION without KICK_SHA256 refuses the install.
#  9. Kick.prev always holds the last installed version: an install interrupted after the binary swap (before Kick.version
#     was written) is recognised through Kick.installing and does not overwrite Kick.prev with the half-installed binary.
# 10. Rollback: a ROLLBACK file on the USB drive (or /data/Kick.rollback, written by the app) restores Kick.prev /
#     Kick.version.prev (checked against the KICK_SHA256 stored in Kick.version.prev). The package that was rolled back from is
#     remembered in /data/Kick.rejected and is not installed again from the same pendrive until a different package appears
#     (or Kick.rejected is deleted).
# 11. Power button: Kick is exec'd under `systemd-inhibit --what=handle-power-key` when a probe run of it works (Kick handles the
#     button itself); otherwise the plain exec (KICK_NO_POWER_INHIBIT=1 forces it, KICK_INHIBIT_BIN overrides the tool for tests).
# Test hook: KICK_BOOT_DRY_RUN=1 stops before the launch, =2 runs the inhibitor decision and exits instead of exec.
# Test hook: KICK_BOOT_TEST_ABORT_AFTER=replace stops (exit 99) right after the binary swap, simulating a power cut.
set -u

# Resolve script directory
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# Source tkgl_path generated by az01-launch-MPC if present
if [ -f "$SCRIPT_DIR/tkgl_path" ]; then
    # shellcheck disable=SC1090,SC1091
    . "$SCRIPT_DIR/tkgl_path"
fi

# Fallback definitions if not provided by tkgl_path
TKGL_ROOT="${TKGL_ROOT:-$(cd "$SCRIPT_DIR/.." && pwd)}"
TKGL_SCRIPT="${TKGL_SCRIPT:-$SCRIPT_DIR}"
TKGL_BIN="${TKGL_BIN:-$TKGL_ROOT/bin}"
TKGL_LOGS="${TKGL_LOGS:-$TKGL_ROOT/logs}"
TKGL_CONF="${TKGL_CONF:-$TKGL_ROOT/conf}"
TKGL_LIB="${TKGL_LIB:-$TKGL_ROOT/lib}"
MOUNT_POINT="${MOUNT_POINT:-$(cd "$TKGL_ROOT/.." && pwd)}"
DEVICE="${DEVICE:-unknown}"

# Internal data directory (/data on MPC; configurable for testing)
KICK_DATA_DIR="${KICK_DATA_DIR:-/data}"

# Log files
BOOT_LOG_LOCAL="$KICK_DATA_DIR/kick-boot.log"
BOOT_LOG_USB="$TKGL_LOGS/kick-boot.log"

log() {
    ts="$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null || date 2>/dev/null || echo "timestamp")"
    msg="[tkgl_bootstrap $ts] $*"
    echo "$msg"

    # Write to internal flash log
    if [ -d "$KICK_DATA_DIR" ]; then
        echo "$msg" >> "$BOOT_LOG_LOCAL" 2>/dev/null || true
    fi

    # Write to USB log if writable
    if [ -d "$TKGL_LOGS" ]; then
        echo "$msg" >> "$BOOT_LOG_USB" 2>/dev/null || true
    fi
}

calc_sha256() {
    target_file="$1"
    if [ ! -f "$target_file" ]; then
        echo ""
        return 0
    fi
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$target_file" 2>/dev/null | awk '{print $1}'
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$target_file" 2>/dev/null | awk '{print $1}'
    else
        echo ""
    fi
}

log "=== Kick bootstrap starting ==="
log "Device: $DEVICE, Mount: $MOUNT_POINT, Root: $TKGL_ROOT"

# -----------------------------------------------------------------------------
# Check for UNINSTALL trigger on USB
# -----------------------------------------------------------------------------
UNINSTALL_TRIGGER=""
if [ -f "$MOUNT_POINT/UNINSTALL" ]; then
    UNINSTALL_TRIGGER="$MOUNT_POINT/UNINSTALL"
elif [ -f "$TKGL_ROOT/UNINSTALL" ]; then
    UNINSTALL_TRIGGER="$TKGL_ROOT/UNINSTALL"
elif [ -f "$TKGL_CONF/UNINSTALL" ]; then
    UNINSTALL_TRIGGER="$TKGL_CONF/UNINSTALL"
fi

if [ -n "$UNINSTALL_TRIGGER" ]; then
    log "UNINSTALL trigger detected: $UNINSTALL_TRIGGER"
    log "Removing Kick files from internal flash ($KICK_DATA_DIR)..."

    rm -f "$KICK_DATA_DIR/Kick" \
          "$KICK_DATA_DIR/Kick.new" \
          "$KICK_DATA_DIR/Kick.installing" \
          "$KICK_DATA_DIR/Kick.rejected" \
          "$KICK_DATA_DIR/Kick.rollback" \
          "$KICK_DATA_DIR/Kick.prev" \
          "$KICK_DATA_DIR/Kick.prev."* \
          "$KICK_DATA_DIR/Kick.version"* \
          "$KICK_DATA_DIR/Kick.bak."* \
          "$KICK_DATA_DIR/kick_cmd" \
          "$KICK_DATA_DIR/kick_screen.ppm" \
          "$KICK_DATA_DIR/kick_probe.txt" \
          "$KICK_DATA_DIR/kick.crash" \
          2>/dev/null || true

    log "Kick binaries and runtime artifacts removed (user projects and preferences preserved)."

    if mv -f "$UNINSTALL_TRIGGER" "${UNINSTALL_TRIGGER}.done" 2>/dev/null; then
        log "Trigger renamed to ${UNINSTALL_TRIGGER}.done."
    else
        rm -f "$UNINSTALL_TRIGGER" 2>/dev/null || true
    fi

    sync 2>/dev/null || true
    log "Uninstall complete. Returning to stock MPC (exit 0)."
    exit 0
fi

# -----------------------------------------------------------------------------
# ROLLBACK trigger (USB drive or /data/Kick.rollback)
# -----------------------------------------------------------------------------
ROLLBACK_TRIGGER=""
for cand in "$MOUNT_POINT/ROLLBACK" "$TKGL_ROOT/ROLLBACK" "$TKGL_CONF/ROLLBACK" "$KICK_DATA_DIR/Kick.rollback"; do
    if [ -f "$cand" ]; then
        ROLLBACK_TRIGGER="$cand"
        break
    fi
done

consume_trigger() {
    trig="$1"
    if [ "$trig" = "$KICK_DATA_DIR/Kick.rollback" ]; then
        rm -f "$trig" 2>/dev/null || true
    elif ! mv -f "$trig" "${trig}.done" 2>/dev/null; then
        rm -f "$trig" 2>/dev/null || true
    fi
}

if [ -n "$ROLLBACK_TRIGGER" ]; then
    log "ROLLBACK trigger detected: $ROLLBACK_TRIGGER"
    PREV_BIN="$KICK_DATA_DIR/Kick.prev"
    PREV_VER="$KICK_DATA_DIR/Kick.version.prev"
    RB_OK=1
    if [ ! -f "$PREV_BIN" ] || [ ! -f "$PREV_VER" ]; then
        log "ROLLBACK refused: no previous version ($PREV_BIN / $PREV_VER missing). Nothing changed."
        RB_OK=0
    else
        RB_EXPECTED="$(grep '^KICK_SHA256=' "$PREV_VER" 2>/dev/null | cut -d= -f2- | tr -d ' "\r' | tr 'A-F' 'a-f' || true)"
        RB_ACTUAL="$(calc_sha256 "$PREV_BIN")"
        if [ -z "$RB_ACTUAL" ] || [ -z "$RB_EXPECTED" ]; then
            log "ROLLBACK refused: cannot verify Kick.prev (no sha256 tool or no KICK_SHA256 in Kick.version.prev). Nothing changed."
            RB_OK=0
        elif [ "$RB_EXPECTED" != "$RB_ACTUAL" ]; then
            log "ROLLBACK refused: Kick.prev fails its SHA256 check (expected $RB_EXPECTED, got $RB_ACTUAL). Nothing changed."
            RB_OK=0
        fi
    fi
    if [ "$RB_OK" -eq 1 ]; then
        rm -f "$KICK_DATA_DIR/Kick.new" "$KICK_DATA_DIR/Kick.version.new" 2>/dev/null || true
        if ! cp -f "$PREV_BIN" "$KICK_DATA_DIR/Kick.new" || [ "$(calc_sha256 "$KICK_DATA_DIR/Kick.new")" != "$RB_EXPECTED" ]; then
            log "ROLLBACK failed: copying Kick.prev did not verify. Nothing changed."
            rm -f "$KICK_DATA_DIR/Kick.new" 2>/dev/null || true
        else
            # Remember the package we are leaving so the same pendrive does not reinstall it at the next boot.
            if [ -f "$KICK_DATA_DIR/Kick.version" ]; then
                cp -f "$KICK_DATA_DIR/Kick.version" "$KICK_DATA_DIR/Kick.rejected" 2>/dev/null || true
            fi
            chmod 755 "$KICK_DATA_DIR/Kick.new"
            mv -f "$KICK_DATA_DIR/Kick.new" "$KICK_DATA_DIR/Kick"
            cp -f "$PREV_VER" "$KICK_DATA_DIR/Kick.version.new"
            mv -f "$KICK_DATA_DIR/Kick.version.new" "$KICK_DATA_DIR/Kick.version"
            rm -f "$KICK_DATA_DIR/Kick.installing" 2>/dev/null || true
            sync 2>/dev/null || true
            log "ROLLBACK complete: Kick is now $(head -n 1 "$KICK_DATA_DIR/Kick.version" 2>/dev/null)."
        fi
    fi
    consume_trigger "$ROLLBACK_TRIGGER"
fi

# -----------------------------------------------------------------------------
# Version and Installation Assessment
# -----------------------------------------------------------------------------
PKG_VERSION_FILE="$TKGL_ROOT/VERSION"
LOCAL_VERSION_FILE="$KICK_DATA_DIR/Kick.version"
PKG_BIN="$TKGL_BIN/Kick"
LOCAL_BIN="$KICK_DATA_DIR/Kick"
REJECTED_FILE="$KICK_DATA_DIR/Kick.rejected"
INSTALLING_MARK="$KICK_DATA_DIR/Kick.installing"

NEEDS_INSTALL=0

if [ ! -f "$LOCAL_BIN" ] || [ ! -x "$LOCAL_BIN" ]; then
    log "Kick is not installed at $LOCAL_BIN. Fresh installation required."
    NEEDS_INSTALL=1
elif [ ! -f "$PKG_VERSION_FILE" ]; then
    log "Package VERSION file ($PKG_VERSION_FILE) not found. Skipping flash update."
    NEEDS_INSTALL=0
elif [ -f "$REJECTED_FILE" ] && cmp -s "$PKG_VERSION_FILE" "$REJECTED_FILE"; then
    log "Package $(head -n 1 "$PKG_VERSION_FILE" 2>/dev/null | sed 's/^VERSION=//') was rolled back from; not installing it again (delete $REJECTED_FILE to allow it)."
    NEEDS_INSTALL=0
elif [ ! -f "$LOCAL_VERSION_FILE" ]; then
    log "Local $LOCAL_VERSION_FILE missing. Re-installation / sync required."
    NEEDS_INSTALL=1
elif cmp -s "$PKG_VERSION_FILE" "$LOCAL_VERSION_FILE"; then
    cur_ver="$(head -n 1 "$LOCAL_VERSION_FILE" 2>/dev/null || echo "unknown")"
    log "Installed version matches package ($cur_ver). Flash write skipped."
    NEEDS_INSTALL=0
else
    old_ver="$(head -n 1 "$LOCAL_VERSION_FILE" 2>/dev/null || echo "unknown")"
    new_ver="$(head -n 1 "$PKG_VERSION_FILE" 2>/dev/null || echo "unknown")"
    log "Version difference detected: local '$old_ver' vs package '$new_ver'. Update/rollback required."
    NEEDS_INSTALL=1
fi

# -----------------------------------------------------------------------------
# Atomic Installation / Update
# -----------------------------------------------------------------------------
if [ "$NEEDS_INSTALL" -eq 1 ]; then
    if [ ! -f "$PKG_BIN" ]; then
        log "WARNING: Package binary $PKG_BIN not found!"
        if [ -x "$LOCAL_BIN" ]; then
            log "Falling back to existing installed binary at $LOCAL_BIN."
        else
            log "ERROR: No runnable Kick binary found on flash. Exiting 0 to let stock MPC start."
            exit 0
        fi
    else
        log "Installing Kick from $PKG_BIN to $LOCAL_BIN..."
        mkdir -p "$KICK_DATA_DIR"

        # 1. Copy to temporary file
        rm -f "$KICK_DATA_DIR/Kick.new" 2>/dev/null || true
        if ! cp -f "$PKG_BIN" "$KICK_DATA_DIR/Kick.new"; then
            log "ERROR: Copy to $KICK_DATA_DIR/Kick.new failed!"
            rm -f "$KICK_DATA_DIR/Kick.new" 2>/dev/null || true
            if [ ! -x "$LOCAL_BIN" ]; then
                log "No existing runnable Kick binary. Exiting 0 to stock MPC."
                exit 0
            fi
        else
            # 2. Check integrity (SHA256)
            EXPECTED_SHA=""
            if [ -f "$PKG_VERSION_FILE" ]; then
                EXPECTED_SHA="$(grep '^KICK_SHA256=' "$PKG_VERSION_FILE" 2>/dev/null | cut -d= -f2- | tr -d ' "\r' || true)"
            fi

            EXPECTED_SHA="$(printf '%s' "$EXPECTED_SHA" | tr 'A-F' 'a-f')"
            COPIED_SHA="$(calc_sha256 "$KICK_DATA_DIR/Kick.new")"

            # An unverifiable package is refused, never installed silently.
            INTEGRITY_OK=1
            if [ -z "$COPIED_SHA" ]; then
                log "ERROR: no sha256sum/shasum available on this system; refusing to install an unverified Kick binary!"
                INTEGRITY_OK=0
            elif [ -z "$EXPECTED_SHA" ]; then
                log "ERROR: package VERSION has no KICK_SHA256; refusing to install an unverified Kick binary!"
                INTEGRITY_OK=0
            elif [ "$EXPECTED_SHA" != "$COPIED_SHA" ]; then
                log "ERROR: SHA256 mismatch for Kick.new (expected $EXPECTED_SHA, got $COPIED_SHA)!"
                INTEGRITY_OK=0
            fi

            if [ "$INTEGRITY_OK" -ne 1 ]; then
                log "Integrity verification failed. Discarding Kick.new."
                rm -f "$KICK_DATA_DIR/Kick.new" 2>/dev/null || true
                if [ ! -x "$LOCAL_BIN" ]; then
                    log "No runnable Kick binary available. Exiting 0 to stock MPC."
                    exit 0
                else
                    log "Retaining existing installed binary at $LOCAL_BIN."
                fi
            else
                # 3. Backup previous binary. If an earlier install was cut after the binary swap, the binary on flash already is the
                #    package being installed (Kick.installing holds its SHA256) and Kick.prev is still the real previous version.
                SKIP_BACKUP=0
                if [ -f "$INSTALLING_MARK" ] && [ -f "$LOCAL_BIN" ]; then
                    marked="$(head -n 1 "$INSTALLING_MARK" 2>/dev/null | tr -d ' \r')"
                    if [ -n "$marked" ] && [ "$(calc_sha256 "$LOCAL_BIN")" = "$marked" ]; then
                        SKIP_BACKUP=1
                        log "Interrupted installation detected: $LOCAL_BIN already is the package binary. Kick.prev is kept."
                    fi
                fi
                if [ "$SKIP_BACKUP" -eq 0 ]; then
                    rm -f "$KICK_DATA_DIR/Kick.prev.tmp" "$KICK_DATA_DIR/Kick.version.prev.tmp" 2>/dev/null || true
                    if [ -f "$LOCAL_BIN" ] && cp -f "$LOCAL_BIN" "$KICK_DATA_DIR/Kick.prev.tmp" 2>/dev/null; then
                        if [ -f "$LOCAL_VERSION_FILE" ]; then
                            cp -f "$LOCAL_VERSION_FILE" "$KICK_DATA_DIR/Kick.version.prev.tmp" 2>/dev/null || true
                        fi
                        mv -f "$KICK_DATA_DIR/Kick.prev.tmp" "$KICK_DATA_DIR/Kick.prev"
                        if [ -f "$KICK_DATA_DIR/Kick.version.prev.tmp" ]; then
                            mv -f "$KICK_DATA_DIR/Kick.version.prev.tmp" "$KICK_DATA_DIR/Kick.version.prev"
                        else
                            rm -f "$KICK_DATA_DIR/Kick.version.prev" 2>/dev/null || true
                        fi
                        log "Saved previous binary backup to $KICK_DATA_DIR/Kick.prev."
                    elif [ -f "$LOCAL_BIN" ]; then
                        rm -f "$KICK_DATA_DIR/Kick.prev.tmp" 2>/dev/null || true
                        log "WARNING: could not back up the previous binary (flash full?); rollback will not be available."
                    fi
                    printf '%s\n' "$COPIED_SHA" > "$INSTALLING_MARK"
                fi

                # 4. Atomic move and permission setup
                chmod 755 "$KICK_DATA_DIR/Kick.new"
                mv -f "$KICK_DATA_DIR/Kick.new" "$LOCAL_BIN"
                log "Atomic replace complete: $LOCAL_BIN is in place."
                if [ "${KICK_BOOT_TEST_ABORT_AFTER:-}" = "replace" ]; then
                    log "KICK_BOOT_TEST_ABORT_AFTER=replace: simulating a power cut after the binary swap."
                    exit 99
                fi

                # 5. Sync resources (assets, templates, demos)
                # User projects in /data/projects and user preferences in /data/prefs are NEVER overwritten.
                if [ -d "$TKGL_ROOT/assets" ]; then
                    mkdir -p "$KICK_DATA_DIR/assets"
                    cp -R -f "$TKGL_ROOT/assets/"* "$KICK_DATA_DIR/assets/" 2>/dev/null || true
                    log "Assets synced to $KICK_DATA_DIR/assets."
                fi

                if [ -d "$TKGL_ROOT/templates" ]; then
                    mkdir -p "$KICK_DATA_DIR/templates"
                    cp -R -f "$TKGL_ROOT/templates/"* "$KICK_DATA_DIR/templates/" 2>/dev/null || true
                    log "Templates synced to $KICK_DATA_DIR/templates."
                fi

                if [ -d "$TKGL_ROOT/demos" ]; then
                    mkdir -p "$KICK_DATA_DIR/demos"
                    cp -R -f "$TKGL_ROOT/demos/"* "$KICK_DATA_DIR/demos/" 2>/dev/null || true
                    log "Demos synced to $KICK_DATA_DIR/demos."
                fi

                if [ -d "$TKGL_ROOT/sounds" ]; then
                    mkdir -p "$KICK_DATA_DIR/sounds"
                    cp -R "$TKGL_ROOT/sounds/"* "$KICK_DATA_DIR/sounds/" 2>/dev/null || true
                    log "Factory sounds synced to $KICK_DATA_DIR/sounds."
                fi

                # 6. Update VERSION file LAST
                if [ -f "$PKG_VERSION_FILE" ]; then
                    cp -f "$PKG_VERSION_FILE" "$KICK_DATA_DIR/Kick.version.new"
                    mv -f "$KICK_DATA_DIR/Kick.version.new" "$LOCAL_VERSION_FILE"
                    log "Updated $LOCAL_VERSION_FILE to version: $(head -n 1 "$LOCAL_VERSION_FILE" 2>/dev/null)."
                fi

                rm -f "$INSTALLING_MARK" "$REJECTED_FILE" 2>/dev/null || true
                sync 2>/dev/null || true
                log "Installation/update finished successfully."
            fi
        fi
    fi
fi

# -----------------------------------------------------------------------------
# Launch Kick Application
# -----------------------------------------------------------------------------
if [ ! -f "$LOCAL_BIN" ] || [ ! -x "$LOCAL_BIN" ]; then
    log "ERROR: $LOCAL_BIN is not executable or does not exist. Exiting 0 to stock MPC."
    exit 0
fi

log "Preparing to launch Kick from internal flash ($LOCAL_BIN)..."

# Test / dry-run hook
if [ "${KICK_BOOT_DRY_RUN:-0}" = "1" ]; then
    log "KICK_BOOT_DRY_RUN=1 requested. Skipping exec, exiting 0."
    exit 0
fi

# Rotate previous stdout/stderr log
if [ -f "$KICK_DATA_DIR/kick.log" ]; then
    mv -f "$KICK_DATA_DIR/kick.log" "$KICK_DATA_DIR/kick.log.old" 2>/dev/null || true
fi

cd "$KICK_DATA_DIR" || {
    log "ERROR: Cannot change directory to $KICK_DATA_DIR"
    exit 0
}
export KICK_NO_HARDWARE=1
export KICK_NO_SERIAL_DEVICE=1

# Power button: Kick reads it itself (Power window: Shut Down / Restart, like the factory MPC app). The factory launcher starts
# the MPC app under `systemd-inhibit --what=handle-power-key` so logind does not also power the device off on the same press
# (and without saving the project). Do the same, but only when the inhibitor demonstrably works here: a probe run must succeed,
# otherwise systemd-inhibit would refuse to start Kick at all. No systemd-inhibit / logind not answering: the plain exec as before.
INHIBIT_BIN="${KICK_INHIBIT_BIN:-systemd-inhibit}"
USE_INHIBIT=0
if [ "${KICK_NO_POWER_INHIBIT:-0}" = "1" ]; then
    log "KICK_NO_POWER_INHIBIT=1: starting Kick without the power key inhibitor."
elif ! command -v "$INHIBIT_BIN" >/dev/null 2>&1; then
    log "No $INHIBIT_BIN on this system: starting Kick without the power key inhibitor (logind may handle the power key too)."
elif "$INHIBIT_BIN" --what=handle-power-key --who=Kick --why="Kick probe" true >/dev/null 2>&1; then
    USE_INHIBIT=1
else
    log "$INHIBIT_BIN probe failed: starting Kick without the power key inhibitor (logind may handle the power key too)."
fi

if [ "$USE_INHIBIT" -eq 1 ]; then
    if [ "${KICK_BOOT_DRY_RUN:-0}" = "2" ]; then
        log "KICK_BOOT_DRY_RUN=2: would exec: $INHIBIT_BIN --what=handle-power-key --who=Kick --why=... $LOCAL_BIN"
        exit 0
    fi
    log "Executing $LOCAL_BIN under $INHIBIT_BIN --what=handle-power-key (KICK_NO_HARDWARE=1, KICK_NO_SERIAL_DEVICE=1)..."
    exec "$INHIBIT_BIN" --what=handle-power-key --who=Kick --why="Kick handles the power button" "$LOCAL_BIN" >> "$KICK_DATA_DIR/kick.log" 2>&1
fi

if [ "${KICK_BOOT_DRY_RUN:-0}" = "2" ]; then
    log "KICK_BOOT_DRY_RUN=2: would exec: $LOCAL_BIN"
    exit 0
fi
log "Executing $LOCAL_BIN (KICK_NO_HARDWARE=1, KICK_NO_SERIAL_DEVICE=1)..."
exec "$LOCAL_BIN" >> "$KICK_DATA_DIR/kick.log" 2>&1
